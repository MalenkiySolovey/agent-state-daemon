{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-state-protocol:v1:common:error-detail",
  "title": "ErrorDetail",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "errorCode", "message"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "errorCode": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z][a-z0-9_.-]*$" },
    "message": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "details": {
      "type": ["object", "null"],
      "maxProperties": 32,
      "propertyNames": { "type": "string", "minLength": 1, "maxLength": 128 },
      "additionalProperties": { "type": "string", "maxLength": 512 }
    },
    "retryable": { "type": ["boolean", "null"] }
  }
}
