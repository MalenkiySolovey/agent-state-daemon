{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-state-protocol:v1:common:secret-reference",
  "title": "SecretReference",
  "description": "Opaque locator for protected secret material; never contains the secret value.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "secretId", "kind"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "secretId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "kind": { "type": "string", "enum": ["codex-auth", "codex-oauth", "api-key", "totp"] }
  }
}
