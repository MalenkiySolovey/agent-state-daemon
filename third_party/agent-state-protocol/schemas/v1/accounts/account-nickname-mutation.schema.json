{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-state-protocol:v1:accounts:account-nickname-mutation",
  "title": "AccountNicknameMutation",
  "description": "Compare-and-set request to set, replace, or explicitly clear a user-selected nickname.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "accountId", "nickname", "safeFallbackDisplayName", "expectedRevision"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "accountId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "nickname": { "type": ["string", "null"], "minLength": 1, "maxLength": 256, "pattern": "\\S" },
    "safeFallbackDisplayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "allOf": [
        { "pattern": "\\S" },
        { "not": { "pattern": "@" } }
      ]
    },
    "expectedRevision": { "type": "string", "minLength": 1, "maxLength": 256 }
  },
  "allOf": [
    {
      "if": {
        "properties": { "nickname": { "type": "string" } },
        "required": ["nickname"]
      },
      "then": {
        "properties": { "safeFallbackDisplayName": { "const": "Account" } }
      }
    }
  ]
}
