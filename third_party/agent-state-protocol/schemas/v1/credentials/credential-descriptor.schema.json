{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-state-protocol:v1:credentials:credential-descriptor",
  "title": "CredentialDescriptor",
  "description": "Credential metadata only; the credential material is not present.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "credentialId", "ownerId", "kind", "state", "revision", "updatedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "credentialId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "ownerId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "kind": { "type": "string", "enum": ["codex-oauth", "api-key", "totp"] },
    "state": { "type": "string", "enum": ["available", "missing", "invalid", "locked"] },
    "revision": { "type": ["string", "null"], "maxLength": 256, "description": "Opaque; never a vault path or hash algorithm value." },
    "updatedAt": { "type": ["string", "null"], "format": "date-time", "pattern": "Z$" }
  }
}
