<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>AgentStateDaemon.IntegrationTests</AssemblyName>
    <RootNamespace>AgentStateDaemon.IntegrationTests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AgentStateDaemon.Core\AgentStateDaemon.Core.csproj" />
    <ProjectReference Include="..\..\src\AgentStateDaemon.Storage.Sqlite\AgentStateDaemon.Storage.Sqlite.csproj" />
    <ProjectReference Include="..\..\src\AgentStateDaemon.Rpc\AgentStateDaemon.Rpc.csproj" />
    <ProjectReference Include="..\..\src\AgentStateDaemon.Transport.NamedPipes\AgentStateDaemon.Transport.NamedPipes.csproj" />
    <ProjectReference Include="..\..\src\AgentStateDaemon.Client\AgentStateDaemon.Client.csproj" />
    <ProjectReference Include="..\..\src\AgentStateDaemon.Host\AgentStateDaemon.Host.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\AgentStateDaemon.TestSupport\AgentStateDaemon.TestSupport.csproj" ReferenceOutputAssembly="false" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <Content Include="..\..\third_party\agent-state-protocol\**\*" Link="canonical-protocol\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyDaemonProcessesForIntegrationTests" AfterTargets="Build">
    <ItemGroup>
      <DaemonHostFiles Include="..\..\src\AgentStateDaemon.Host\bin\$(Configuration)\net10.0\**\*" />
      <TestSupportFiles Include="..\AgentStateDaemon.TestSupport\bin\$(Configuration)\net10.0\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(DaemonHostFiles)" DestinationFiles="@(DaemonHostFiles->'$(OutDir)daemon-host\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(TestSupportFiles)" DestinationFiles="@(TestSupportFiles->'$(OutDir)test-support\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
